# PRIVATE CMS ADMIN LOGIN: configure in Vercel Production settings.
# Keep these SERVER-ONLY. NEVER use VITE_ADMIN_EMAIL / VITE_ADMIN_PASSWORD.
ADMIN_EMAIL=
# Must be at least 16 characters. Recommend a random password of 20+ characters.
ADMIN_PASSWORD=

# Existing Neon integration: required for CMS content storage, but not for login.
DATABASE_URL=

# Optional upload support (Vercel Blob: maximum 4 MB file)
BLOB_READ_WRITE_TOKEN=

# Optional contact form CAPTCHA. Configure both site key and server secret.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
