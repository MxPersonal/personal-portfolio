# Neon integrations create these in Vercel (Production and Preview).
# Use ONLY the Neon Auth URL in browser; never expose database connection strings.
VITE_NEON_AUTH_URL=

# Server-side only: injected by Vercel Neon integration
DATABASE_URL=
NEON_AUTH_BASE_URL=

# Optional Vercel Blob for admin image/video upload (<= 4MB)
BLOB_READ_WRITE_TOKEN=

# Optional: enable both frontend Turnstile UI and server verification together.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
